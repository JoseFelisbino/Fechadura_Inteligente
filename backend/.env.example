NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fechadura_inteligente
JWT_SECRET=alterar_este_segredo_por_um_valor_longo_e_aleatorio
JWT_EXPIRES_IN_SECONDS=28800
FRONTEND_URL=http://localhost:5173
COOKIE_NAME=access_token

# Monitoramento
HEARTBEAT_TIMEOUT_SECONDS=90
MONITOR_INTERVAL_SECONDS=5
DEFAULT_MAX_OPEN_SECONDS=300

# MQTT (deixe MQTT_URL vazio para usar somente HTTP)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Arquivo de senhas do Mosquitto atualizado pelos scripts de provisionamento
MOSQUITTO_PASSWD_FILE=../mosquitto/config/passwd

# Banco usado pelos testes automatizados (schema separado)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/fechadura_inteligente?schema=test

# Usuário administrador criado por `npm run seed`
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
