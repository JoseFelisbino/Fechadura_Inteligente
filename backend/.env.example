NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fechadura_inteligente

# Banco usado pelos testes automatizados (schema separado; nunca o mesmo do DATABASE_URL)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/fechadura_inteligente?schema=test

# Broker MQTT (deixe MQTT_URL vazio para rodar a API sem broker).
# O Arduino usa o MESMO usuário e senha (secrets.h: MQTT_USER / MQTT_PASSWORD).
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=fechadura
MQTT_PASSWORD=
# Onde `npm run mqtt:user` grava o usuário acima (arquivo de senhas do Mosquitto)
MOSQUITTO_PASSWD_FILE=../mosquitto/config/passwd

# HTTPS opcional: preencha para a API responder em https:// (necessário quando o app está na Vercel).
# Exemplo com o certificado do Let's Encrypt (veja o README):
# HTTPS_CERT_FILE=certs/cert.pem
# HTTPS_KEY_FILE=certs/key.pem
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Regras de tempo
OFFLINE_APOS_SEGUNDOS=15
COMANDO_EXPIRA_SEGUNDOS=15
MONITOR_INTERVALO_MS=1000
