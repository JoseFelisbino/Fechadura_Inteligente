// Banco da fechadura inteligente (protótipo de demonstração: um único dispositivo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoEvento {
  ACESSO_LIBERADO
  SENHA_INCORRETA
  BLOQUEIO_INICIO
  BLOQUEIO_FIM
  PORTA_ABERTA
  PORTA_FECHADA
  PORTA_NAO_FECHOU
  PORTA_FORCADA
  ALARME_DESLIGADO
  SENHA_ALTERADA
}

/// Quem causou o evento. TECLADO = entrada com senha; TECLADO_SAIDA = 'D' + senha + '#'.
enum Origem {
  TECLADO
  TECLADO_SAIDA
  BOTAO_SAIDA
  APP
  SENSOR
  SISTEMA
}

enum EstadoPorta {
  ABERTA
  FECHADA
  DESCONHECIDA
}

enum EstadoTrava {
  ABERTA
  FECHADA
}

enum TipoComando {
  ABRIR_PORTA
  FECHAR_PORTA
  DESLIGAR_ALARME
  TESTAR_BUZZER
  DEFINIR_SENHA
  REMOVER_SENHA
  DEFINIR_CONFIG
  ENVIAR_ESTADO
}

enum StatusComando {
  PENDENTE
  OK
  FALHOU
  EXPIRADO
}

/// Situação da senha no Arduino.
enum SincronizacaoSenha {
  PENDENTE  // enviada, aguardando resposta
  APLICADA  // o Arduino confirmou
  FALHOU    // o Arduino recusou ou não respondeu
  REMOVENDO // remoção enviada, aguardando resposta
}

enum TipoAlerta {
  PORTA_FORCADA
  PORTA_NAO_FECHOU
  ABERTA_DEMAIS
  OFFLINE
}

enum StatusAlerta {
  ATIVO
  RESOLVIDO
}

/// Histórico de eventos enviados pelo Arduino.
model Evento {
  id         String     @id @default(uuid())
  idExterno  String     @unique // gerado pelo Arduino: evita duplicar quando ele reenvia
  tipo       TipoEvento
  origem     Origem
  usuario    String?
  ocorridoEm DateTime // horário do Arduino (NTP) ou, sem ele, o horário de recebimento
  recebidoEm DateTime   @default(now())

  @@index([ocorridoEm])
  @@index([tipo, ocorridoEm])
}

/// Leituras do sensor para o gráfico (no máximo 1 a cada 5 s, guardadas por 24 h).
model Leitura {
  id          Int         @id @default(autoincrement())
  distanciaCm Int?
  porta       EstadoPorta
  trava       EstadoTrava
  criadoEm    DateTime    @default(now())

  @@index([criadoEm])
}

/// As 3 senhas do teclado. Texto puro: aceitável só porque é uma demonstração.
model Senha {
  slot          Int                @id // 1 a 3
  nome          String
  senha         String
  sincronizacao SincronizacaoSenha @default(PENDENTE)
  motivo        String?
  comandoId     String?
  atualizadoEm  DateTime           @updatedAt
}

model Comando {
  id           String        @id @default(uuid())
  tipo         TipoComando
  params       Json? // nunca guarda a senha
  status       StatusComando @default(PENDENTE)
  motivo       String?
  criadoEm     DateTime      @default(now())
  respondidoEm DateTime?

  @@index([status, criadoEm])
}

/// No máximo um alerta ATIVO por tipo (índice único parcial criado na migration).
model Alerta {
  id          String       @id @default(uuid())
  tipo        TipoAlerta
  status      StatusAlerta @default(ATIVO)
  mensagem    String
  criadoEm    DateTime     @default(now())
  resolvidoEm DateTime?

  @@index([status, criadoEm])
}

/// Linha única (id = 1).
model Configuracao {
  id              Int      @id @default(1)
  tempoAberturaMs Int      @default(5000) // quanto tempo a porta fica aberta
  limiteCm        Int      @default(10) // fechada se distância <= limite
  tempoMaxAbertaS Int      @default(30) // alerta ABERTA_DEMAIS
  atualizadoEm    DateTime @updatedAt
}
